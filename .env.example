# Copy to .env and adjust. .env is git-ignored: never commit real secrets.
# docker compose reads .env automatically; the dev profile uses the same defaults when variables are not set.

# Local PostgreSQL (docker-compose.yml + dev profile)
DB_NAME=spending_limits
DB_USERNAME=spending_limits
DB_PASSWORD=spending_limits
DB_PORT=5432

# prod profile: full JDBC URL is required, there are no defaults
# DB_URL=jdbc:postgresql://db-host:5432/spending_limits

# HTTP port of the service
# SERVER_PORT=8080

RATES_PROVIDER=fixed
TWELVEDATA_API_KEY=

MCP_DB_PASSWORD=mcp_readonly
